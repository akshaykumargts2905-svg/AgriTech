generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  name               String
  state              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  country            String
  email              String              @unique
  id                 Int                 @id @default(autoincrement())
  password           String
  phone              String
  communityComments  CommunityComment[]
  communityPosts     CommunityPost[]
  loanApplications   LoanApplication[]
  loanRepayments     LoanRepayment[]
  rewardAccount      RewardAccount?
  rewardTransactions RewardTransaction[]
  videoComments      VideoComment[]
  videoLikes         VideoLike[]
}

model Weather {
  id          Int      @id @default(autoincrement())
  location    String
  temperature Float
  condition   String
  humidity    Int
  advice      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FarmingTip {
  id        Int      @id @default(autoincrement())
  title     String
  crop      String
  tip       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   @default("all")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Crop {
  cropId    String   @id @default(uuid())
  userId    String
  cropName  String
  quantity  Float
  price     Float
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiseaseDetection {
  detectionId String   @id @default(uuid())
  userId      String
  imageUrl    String
  diseaseName String
  solution    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeatherAlert {
  alertId      String   @id @default(uuid())
  userId       String
  location     String
  weatherType  String
  alertMessage String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MandiPrice {
  priceId        String   @id @default(uuid())
  cropName       String
  market         String
  currentPrice   Float
  predictedPrice Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Marketplace {
  listingId String   @id @default(uuid())
  farmerId  String
  buyerId   String?
  cropId    String
  quantity  Float
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GovernmentScheme {
  schemeId    String   @id @default(uuid())
  schemeName  String
  eligibility String
  applyLink   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseProfit {
  recordId  String   @id @default(uuid())
  farmerId  String
  expense   Float
  income    Float
  profit    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentRental {
  equipmentId   String   @id @default(uuid())
  ownerId       String
  equipmentName String
  rentPrice     Float
  availability  Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RewardLoan {
  rewardId        String   @id @default(uuid())
  farmerId        String
  points          Int
  loanEligibility Boolean
  creditScore     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CommunityPost {
  postId    String             @id @default(uuid())
  farmerId  Int
  title     String
  content   String
  imageUrl  String?
  videoUrl  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  comments  CommunityComment[]
  likes     CommunityLike[]
  farmer    User               @relation(fields: [farmerId], references: [id])
}

model CommunityComment {
  commentId String        @id @default(uuid())
  postId    String
  farmerId  Int
  comment   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  farmer    User          @relation(fields: [farmerId], references: [id])
  post      CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)
}

model CommunityLike {
  likeId    String        @id @default(uuid())
  postId    String
  farmerId  Int
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)

  @@unique([postId, farmerId])
}

model Video {
  videoId      String         @id @default(uuid())
  farmerId     Int?
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  category     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  comments     VideoComment[]
  likes        VideoLike[]
}

model VideoComment {
  commentId String   @id @default(uuid())
  videoId   String
  farmerId  Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farmer    User     @relation(fields: [farmerId], references: [id])
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
}

model VideoLike {
  likeId    String   @id @default(uuid())
  videoId   String
  farmerId  Int
  createdAt DateTime @default(now())
  farmer    User     @relation(fields: [farmerId], references: [id])
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@unique([videoId, farmerId])
}

model RewardAccount {
  accountId String   @id @default(uuid())
  farmerId  Int      @unique
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farmer    User     @relation(fields: [farmerId], references: [id])
}

model RewardTransaction {
  transactionId String   @id @default(uuid())
  farmerId      Int
  points        Int
  reason        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())
  farmer        User     @relation(fields: [farmerId], references: [id])
}

model LoanApplication {
  loanId         String          @id @default(uuid())
  farmerId       Int
  amount         Float
  purpose        String
  durationMonths Int
  status         LoanStatus      @default(PENDING)
  creditScore    Int
  documentUrl    String?
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  farmer         User            @relation(fields: [farmerId], references: [id])
  repayments     LoanRepayment[]
}

model LoanRepayment {
  repaymentId String          @id @default(uuid())
  loanId      String
  farmerId    Int
  amount      Float
  paidAt      DateTime        @default(now())
  farmer      User            @relation(fields: [farmerId], references: [id])
  loan        LoanApplication @relation(fields: [loanId], references: [loanId], onDelete: Cascade)
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  REPAID
}
