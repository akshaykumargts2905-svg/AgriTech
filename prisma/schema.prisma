generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  state     String
  country   String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  videoComments     VideoComment[]
  videoLikes        VideoLike[]
  rewardAccount     RewardAccount?
  rewardTransactions RewardTransaction[]
  loanApplications  LoanApplication[]
  loanRepayments    LoanRepayment[]
}

model Crop {
  cropId    String   @id @default(uuid())
  userId    String
  cropName  String
  quantity  Float
  price     Float
  status    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiseaseDetection {
  detectionId String   @id @default(uuid())
  userId      String
  imageUrl    String
  diseaseName String
  solution    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeatherAlert {
  alertId      String   @id @default(uuid())
  userId       String
  location     String
  weatherType  String
  alertMessage String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MandiPrice {
  priceId        String   @id @default(uuid())
  cropName       String
  market         String
  currentPrice   Float
  predictedPrice Float

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Marketplace {
  listingId String   @id @default(uuid())
  farmerId  String
  buyerId   String?
  cropId    String
  quantity  Float
  amount    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GovernmentScheme {
  schemeId    String   @id @default(uuid())
  schemeName  String
  eligibility String
  applyLink   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseProfit {
  recordId  String   @id @default(uuid())
  farmerId  String
  expense   Float
  income    Float
  profit    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentRental {
  equipmentId   String   @id @default(uuid())
  ownerId       String
  equipmentName String
  rentPrice     Float
  availability  Boolean

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RewardLoan {
  rewardId        String   @id @default(uuid())
  farmerId        String
  points          Int
  loanEligibility Boolean
  creditScore     Int

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CommunityPost {
  postId    String             @id @default(uuid())
  farmerId  Int
  title     String
  content   String
  imageUrl  String?
  videoUrl  String?
  farmer    User               @relation(fields: [farmerId], references: [id])
  comments  CommunityComment[]
  likes     CommunityLike[]

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model CommunityComment {
  commentId String        @id @default(uuid())
  postId    String
  farmerId  Int
  comment   String
  post      CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)
  farmer    User          @relation(fields: [farmerId], references: [id])

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CommunityLike {
  likeId    String        @id @default(uuid())
  postId    String
  farmerId  Int
  post      CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)

  createdAt DateTime      @default(now())

  @@unique([postId, farmerId])
}

model Video {
  videoId     String         @id @default(uuid())
  farmerId    Int?
  title       String
  description String?
  videoUrl    String
  thumbnailUrl String?
  category    String?
  comments    VideoComment[]
  likes       VideoLike[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VideoComment {
  commentId String   @id @default(uuid())
  videoId   String
  farmerId  Int
  comment   String
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  farmer    User     @relation(fields: [farmerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoLike {
  likeId    String   @id @default(uuid())
  videoId   String
  farmerId  Int
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  farmer    User     @relation(fields: [farmerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([videoId, farmerId])
}

model RewardAccount {
  accountId String @id @default(uuid())
  farmerId  Int    @unique
  points    Int    @default(0)
  farmer    User   @relation(fields: [farmerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RewardTransaction {
  transactionId String @id @default(uuid())
  farmerId      Int
  points        Int
  reason        String
  referenceType String?
  referenceId   String?
  farmer        User   @relation(fields: [farmerId], references: [id])

  createdAt     DateTime @default(now())
}

model LoanApplication {
  loanId       String          @id @default(uuid())
  farmerId     Int
  amount       Float
  purpose      String
  durationMonths Int
  status       LoanStatus      @default(PENDING)
  creditScore  Int
  documentUrl  String?
  remarks      String?
  farmer       User            @relation(fields: [farmerId], references: [id])
  repayments   LoanRepayment[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model LoanRepayment {
  repaymentId String          @id @default(uuid())
  loanId      String
  farmerId    Int
  amount      Float
  paidAt      DateTime        @default(now())
  loan        LoanApplication @relation(fields: [loanId], references: [loanId], onDelete: Cascade)
  farmer      User            @relation(fields: [farmerId], references: [id])
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  REPAID
}
