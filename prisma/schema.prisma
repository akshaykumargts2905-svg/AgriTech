generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String
  state     String
  country   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // crop-management relations
  crops              Crop[]
  diseaseDetections  DiseaseDetection[]
  weatherAlerts      WeatherAlert[]
  expenseProfits     ExpenseProfit[]
  equipmentRentals   EquipmentRental[]
  rewardLoans        RewardLoan[]
  farmerListings     Marketplace[] @relation("FarmerListings")
  buyerPurchases     Marketplace[] @relation("BuyerPurchases")

  // community / video / reward / loan relations
  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  videoComments      VideoComment[]
  videoLikes         VideoLike[]
  rewardAccount      RewardAccount?
  rewardTransactions RewardTransaction[]
  loanApplications   LoanApplication[]
  loanRepayments     LoanRepayment[]
}

model Weather {
  id          Int      @id @default(autoincrement())
  location    String
  temperature Float
  condition   String
  humidity    Int
  advice      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FarmingTip {
  id        Int      @id @default(autoincrement())
  title     String
  crop      String
  tip       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   @default("all")
  title     String
  message   String
  read      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  verified  Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Crop {
  cropId    String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cropName  String
  quantity  Float
  price     Float
  status    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketplaceListings Marketplace[]

  @@index([userId])
}

model DiseaseDetection {
  detectionId String   @id @default(uuid())

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl    String
  diseaseName String
  solution    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model WeatherAlert {
  alertId      String   @id @default(uuid())

  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  location     String
  weatherType  String
  alertMessage String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model MandiPrice {
  priceId        String   @id @default(uuid())

  cropName       String
  market         String
  currentPrice   Float
  predictedPrice Float

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cropName])
  @@index([market])
}

model Marketplace {
  listingId String @id @default(uuid())

  farmerId  Int
  farmer    User @relation("FarmerListings", fields: [farmerId], references: [id])

  buyerId   Int?
  buyer     User? @relation("BuyerPurchases", fields: [buyerId], references: [id])

  cropId    String
  crop      Crop @relation(fields: [cropId], references: [cropId], onDelete: Cascade)

  quantity  Float
  amount    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([buyerId])
  @@index([cropId])
}

model GovernmentScheme {
  schemeId    String   @id @default(uuid())

  schemeName  String
  eligibility String
  applyLink   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseProfit {
  recordId  String   @id @default(uuid())

  farmerId  Int
  farmer    User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  expense   Float
  income    Float
  profit    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
}

model EquipmentRental {
  equipmentId   String   @id @default(uuid())

  ownerId       Int
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  equipmentName String
  rentPrice     Float
  availability  Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
}

model RewardLoan {
  rewardId        String   @id @default(uuid())

  farmerId        Int
  farmer          User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  points          Int      @default(0)
  loanEligibility Boolean  @default(false)
  creditScore     Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([farmerId])
}

model CommunityPost {
  postId    String             @id @default(uuid())
  farmerId  Int
  title     String
  content   String
  imageUrl  String?
  videoUrl  String?
  farmer    User               @relation(fields: [farmerId], references: [id])
  comments  CommunityComment[]
  likes     CommunityLike[]

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model CommunityComment {
  commentId String        @id @default(uuid())
  postId    String
  farmerId  Int
  comment   String
  post      CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)
  farmer    User          @relation(fields: [farmerId], references: [id])

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CommunityLike {
  likeId    String        @id @default(uuid())
  postId    String
  farmerId  Int
  post      CommunityPost @relation(fields: [postId], references: [postId], onDelete: Cascade)

  createdAt DateTime      @default(now())

  @@unique([postId, farmerId])
}

model Video {
  videoId     String         @id @default(uuid())
  farmerId    Int?
  title       String
  description String?
  videoUrl    String
  thumbnailUrl String?
  category    String?
  comments    VideoComment[]
  likes       VideoLike[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VideoComment {
  commentId String   @id @default(uuid())
  videoId   String
  farmerId  Int
  comment   String
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  farmer    User     @relation(fields: [farmerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoLike {
  likeId    String   @id @default(uuid())
  videoId   String
  farmerId  Int
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  farmer    User     @relation(fields: [farmerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([videoId, farmerId])
}

model RewardAccount {
  accountId String @id @default(uuid())
  farmerId  Int    @unique
  points    Int    @default(0)
  farmer    User   @relation(fields: [farmerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RewardTransaction {
  transactionId String @id @default(uuid())
  farmerId      Int
  points        Int
  reason        String
  referenceType String?
  referenceId   String?
  farmer        User   @relation(fields: [farmerId], references: [id])

  createdAt     DateTime @default(now())
}

model LoanApplication {
  loanId       String          @id @default(uuid())
  farmerId     Int
  amount       Float
  purpose      String
  durationMonths Int
  status       LoanStatus      @default(PENDING)
  creditScore  Int
  documentUrl  String?
  remarks      String?
  farmer       User            @relation(fields: [farmerId], references: [id])
  repayments   LoanRepayment[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model LoanRepayment {
  repaymentId String          @id @default(uuid())
  loanId      String
  farmerId    Int
  amount      Float
  paidAt      DateTime        @default(now())
  loan        LoanApplication @relation(fields: [loanId], references: [loanId], onDelete: Cascade)
  farmer      User            @relation(fields: [farmerId], references: [id])
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  REPAID
}
